# =============================================
# Collab Platform — Environment Variables
# =============================================
# Copy this file to .env and fill in values.

# PostgreSQL
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=collab_user
POSTGRES_PASSWORD=collab_secret_password
POSTGRES_DB=collab_platform

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379

# Kafka
KAFKA_BROKER=localhost:9092

# Elasticsearch
ELASTICSEARCH_URL=http://localhost:9200

# JWT
JWT_SECRET=super-secret-jwt-key-change-in-production
JWT_EXPIRES_IN=7d

# MinIO / S3
MINIO_ENDPOINT=localhost
MINIO_PORT=9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=collab-uploads

# Services
USER_SERVICE_PORT=4001
DOCUMENT_SERVICE_PORT=4002
COLLABORATION_SERVICE_PORT=4003
NOTIFICATION_SERVICE_PORT=4004
SEARCH_SERVICE_PORT=4005

# Frontend
NEXT_PUBLIC_API_URL=http://localhost:8080
NEXT_PUBLIC_WS_URL=ws://localhost:4003
